{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stache",
  "version": "0.25.0",
  "identifier": "com.marcosmoura.stache",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "script": "./scripts/generate-schema.sh && pnpm build"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "width": 0,
        "minWidth": 0,
        "height": 0,
        "maxHeight": 0,
        "minHeight": 0,
        "x": 0,
        "y": 0,
        "title": "Bar",
        "label": "bar",
        "url": "#/bar",
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "browserExtensionsEnabled": false,
        "closable": false,
        "create": true,
        "decorations": false,
        "dragDropEnabled": false,
        "focus": false,
        "focusable": false,
        "fullscreen": false,
        "hiddenTitle": true,
        "maximizable": false,
        "maximized": false,
        "minimizable": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "transparent": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "windowEffects": null,
        "zoomHotkeysEnabled": false
      },
      {
        "width": 0,
        "minWidth": 0,
        "height": 0,
        "maxHeight": 0,
        "minHeight": 0,
        "x": 0,
        "y": 0,
        "title": "Widgets",
        "label": "widgets",
        "url": "#/widgets",
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "browserExtensionsEnabled": false,
        "closable": false,
        "create": true,
        "decorations": false,
        "dragDropEnabled": false,
        "focus": false,
        "focusable": false,
        "fullscreen": false,
        "hiddenTitle": true,
        "maximizable": false,
        "maximized": false,
        "minimizable": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "transparent": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "windowEffects": null,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "https://api.open-meteo.com",
          "https://geocoding-api.open-meteo.com",
          "https://weather.visualcrossing.com",
          "https://ipapi.co",
          "https://ipinfo.io"
        ],
        "img-src": ["'self'", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Stache App",
      "infoPlist": "Info.plist",
      "files": {
        "lib": "resources/lib",
        "Frameworks": "resources/Frameworks"
      }
    }
  }
}
