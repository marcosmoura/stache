{
  "$schema": "https://opencode.ai/config.json",

  // Project agents: only `build` and `orchestrator` are primary.
  // Role prompts live in .agents/roles/; .opencode/agents/*.md are thin wrappers.
  "default_agent": "build",

  "agents": {
    "plan": {
      "disabled": true,
      "model": "openai/gpt-6.1-sol#medium",
    },
    "explore": {
      "disabled": true,
      "model": "opencode-go/deepseek-v4.1-flash#low",
    },
    "general": {
      "disabled": true,
      "model": "opencode-go/deepseek-v4.1-flash#high",
    },
    "scout": {
      "disabled": true,
      "model": "opencode-go/deepseek-v4.1-flash#low",
    },
    "shipper": {
      "disabled": true,
      "model": "opencode-go/deepseek-v4.1-flash#low",
    },

    "orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol#medium",
      "color": "#cba6f7",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "subagent", "resource": "spec-writer", "effect": "allow" },
        { "action": "subagent", "resource": "worker", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
      ],
    },

    "explorer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash#low",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
      ],
    },

    "spec-writer": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }],
    },

    "worker": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash#high",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }],
    },

    "reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#high",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
      ],
    },
    "title": {
      "model": "opencode-go/deepseek-v4.1-flash#low",
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash#high",
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol#high",
    },
  },
  "model": "openai/gpt-6.1-sol",
}
