{
  "$schema": "https://opencode.ai/config.json",

  // Project agents: only `build` and `orchestrator` are primary.
  // Role prompts live in .agents/roles/; .opencode/agents/*.md are thin wrappers.
  "default_agent": "build",

  "agents": {
    "plan": {
      "disabled": true,
      "model": "claude-agent/opus#medium",
    },
    "explore": {
      "disabled": true,
      "model": "claude-agent/haiku#low",
    },
    "general": {
      "disabled": true,
      "model": "claude-agent/sonnet#medium",
    },

    "orchestrator": {
      "mode": "primary",
      "model": "claude-agent/opus#medium",
      "color": "#cba6f7",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "worker", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
      ],
    },

    "worker": {
      "mode": "subagent",
      "model": "claude-agent/opus#low",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }],
    },

    "reviewer": {
      "mode": "subagent",
      "model": "claude-agent/opus#medium",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
      ],
    },
    "title": {
      "model": "claude-agent/haiku#low",
    },
    "build": {
      "model": "claude-agent/sonnet#medium",
    },
    "compaction": {
      "model": "claude-agent/opus#medium",
    },
  },
  "model": "claude-agent/sonnet",
}
