{
  "name": "stache-next",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/prepare.ts",
    "dev": "vite",
    "build": "bun run check:generated && tsc -b && vite build",
    "tauri:dev": "tauri dev --config src/crates/app/tauri.conf.json",
    "tauri:build": "tauri build --features custom-protocol --config src/crates/app/tauri.conf.json",
    "check:generated": "bun run generate-schema -- --check && bun run generate-bindings -- --check",
    "generate-bindings": "cargo run -q -p stache-app --features dev-tools --bin generate-bindings --",
    "generate-schema": "cargo run -q -p stache-app --features dev-tools --bin generate-schema --",
    "lint": "bun run check:generated && bun run lint:ui && bun run lint:native",
    "lint:ui": "tsc -b && oxlint --deny-warnings src/ui scripts vite.config.ts vitest.scripts.config.ts lint-staged.config.ts stylelint.config.mjs && stylelint --allow-empty-input 'src/ui/**/*.{styles.tsx,css}'",
    "lint:native": "cargo sort --workspace --check && cargo clippy --workspace --all-targets --features stache-app/dev-tools -- -D warnings",
    "format": "oxfmt --disable-nested-config && cargo fmt --all",
    "format:check": "oxfmt --disable-nested-config --check && cargo fmt --all -- --check",
    "measure": "bun scripts/measure-foundation.ts",
    "test": "bun run test:ui && bun run test:scripts && bun run test:native",
    "test:ui": "vitest run",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:ui:coverage": "vitest run --coverage",
    "test:native": "cargo nextest run --workspace --features stache-app/dev-tools"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-query": "5.105.3",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@linaria/core": "8.2.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@styled/typescript-styled-plugin": "1.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/eslint-plugin-query": "5.105.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@wyw-in-js/vite": "2.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "postcss-styled-syntax": "0.7.4",
    "stylelint": "18.0.0",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-recommended": "19.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "happy-dom": "21.0.4",
    "minimatch": "11.0.4",
    "tinypool": "2.2.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
