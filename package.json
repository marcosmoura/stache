{
  "name": "stache",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:app": "pnpm tauri:build",
    "dev": "vite",
    "generate-schema": "./scripts/generate-schema.sh",
    "format": "pnpm format:ui && pnpm format:native",
    "format:native": "cargo fmt --all",
    "format:ui": "oxfmt",
    "lint": "pnpm lint:ui && pnpm lint:native",
    "lint:native": "cargo sort --workspace && cargo clippy --workspace --all --fix --allow-dirty --allow-staged -- -D warnings",
    "lint:ui": "pnpm tsc --noEmit && oxlint --fix && stylelint --formatter verbose --fix --allow-empty-input './app/ui/**/*.(styles.ts|css)'",
    "prepare": "./scripts/prepare-sidecar.sh && husky",
    "release": "./scripts/release.sh",
    "tauri": "tauri",
    "tauri:audit": "cargo audit --target-os macos",
    "tauri:build": "tauri build --config app/native/tauri.conf.json",
    "tauri:dev": "RUST_BACKTRACE=full tauri dev --config app/native/tauri.conf.json",
    "test": "pnpm test:ui && pnpm test:native",
    "test:native": "cargo nextest run --workspace",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-store/zustand": "^1.2.1",
    "immer": "^11.1.18",
    "motion": "^13.3.0",
    "openmeteo": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@linaria/core": "^8.2.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@styled/typescript-styled-plugin": "^1.0.1",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-store/shared": "^0.10.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@wyw-in-js/vite": "2.5.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-styled-syntax": "^0.7.2",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~7.0.2",
    "vite": "~8.3.0",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  }
}
