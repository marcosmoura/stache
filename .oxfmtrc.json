{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.toml",
    "**/bindings.gen.ts",
    "**/coverage/**",
    "**/dist/**",
    ".worktrees/**",
    "_legacy/**",
    "bun.lock",
    "node_modules/**",
    "schemas/**",
    "src/crates/app/gen/**",
    "src/crates/app/resources/**",
    "src/ui/tests/bar-reference/fixtures/**",
    "src/ui/tests/bar-reference/icons/**",
    "src/ui/tests/bar-reference/manifest.json",
    "src/ui/tests/bar-reference/reference.css",
    "target/**"
  ],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react-*",
          "react-*/**",
          "react-dom",
          "react-dom/**",
          "react",
          "react/**"
        ]
      },
      {
        "groupName": "project-alias",
        "elementNamePattern": ["@/**"]
      }
    ],
    "groups": [
      ["type-builtin", "value-builtin"],
      "react",
      ["type-external", "value-external"],
      ["type-internal", "value-internal", "project-alias"],
      ["type-parent", "value-parent"],
      ["type-sibling", "value-sibling", "type-index", "value-index"],
      "unknown"
    ]
  },
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all"
}
